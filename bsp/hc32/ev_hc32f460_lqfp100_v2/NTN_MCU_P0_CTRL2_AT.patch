diff --git a/ev_hc32f460_lqfp100_v2/applications/pc_maint_core.c b/applications/pc_maint_core.c
new file mode 100644
index 0000000..a6d6107
--- /dev/null
+++ b/applications/pc_maint_core.c
@@ -0,0 +1,210 @@
+/* SPDX-License-Identifier: Apache-2.0 */
+#include "pc_maint_core.h"
+#include <string.h>
+
+static void replay(pc_maint_ctx_t *ctx, const pc_maint_callbacks_t *cb)
+{
+    if (ctx->length != 0U && cb != NULL && cb->raw != NULL)
+        cb->raw(cb->user, ctx->candidate, ctx->length);
+    ctx->length = 0U;
+    ctx->state = PC_MAINT_RAW;
+}
+
+void pc_maint_init(pc_maint_ctx_t *ctx)
+{
+    memset(ctx, 0, sizeof(*ctx));
+}
+
+void pc_maint_reset(pc_maint_ctx_t *ctx, const pc_maint_callbacks_t *cb,
+                    int replay_candidate)
+{
+    if (ctx->state != PC_MAINT_SESSION &&
+        ctx->state != PC_MAINT_DRAIN && replay_candidate)
+        replay(ctx, cb);
+    ctx->state = PC_MAINT_RAW;
+    ctx->length = 0U;
+    ctx->skip_next_lf = 0U;
+}
+
+int pc_maint_active(const pc_maint_ctx_t *ctx)
+{
+    return ctx->state == PC_MAINT_SESSION || ctx->state == PC_MAINT_DRAIN;
+}
+
+void pc_maint_poll(pc_maint_ctx_t *ctx, uint32_t now_ms, int enabled,
+                   const pc_maint_callbacks_t *cb)
+{
+    if (!enabled)
+    {
+        pc_maint_reset(ctx, cb, 1);
+        return;
+    }
+    if ((ctx->state == PC_MAINT_PLUS1 || ctx->state == PC_MAINT_PLUS2) &&
+        (uint32_t)(now_ms - ctx->stage_ms) > PC_MAINT_PLUS_GAP_MS)
+        replay(ctx, cb);
+    else if (ctx->state == PC_MAINT_POST &&
+             (uint32_t)(now_ms - ctx->stage_ms) >= PC_MAINT_POST_GUARD_MS)
+    {
+        ctx->state = PC_MAINT_CONFIRM;
+        ctx->stage_ms += PC_MAINT_POST_GUARD_MS;
+        if ((uint32_t)(now_ms - ctx->stage_ms) >= PC_MAINT_CONFIRM_MS)
+            replay(ctx, cb);
+    }
+    else if (ctx->state == PC_MAINT_CONFIRM &&
+             (uint32_t)(now_ms - ctx->stage_ms) >= PC_MAINT_CONFIRM_MS)
+        replay(ctx, cb);
+    else if ((ctx->state == PC_MAINT_SESSION ||
+              ctx->state == PC_MAINT_DRAIN) &&
+             (uint32_t)(now_ms - ctx->session_activity_ms) >= PC_MAINT_IDLE_MS)
+    {
+        /* Never replay a partial maintenance command as telemetry. */
+        ctx->state = PC_MAINT_RAW;
+        ctx->length = 0U;
+    }
+}
+
+static void emit_raw(const pc_maint_callbacks_t *cb, const uint8_t *buf, size_t len)
+{
+    if (len != 0U && cb != NULL && cb->raw != NULL)
+        cb->raw(cb->user, buf, len);
+}
+
+void pc_maint_input(pc_maint_ctx_t *ctx, const uint8_t *bytes, size_t len,
+                    uint32_t now_ms, int enabled, const pc_maint_callbacks_t *cb)
+{
+    uint8_t plain[PC_MAINT_CANDIDATE_MAX];
+    size_t plain_len = 0U;
+    size_t i;
+    if (ctx == NULL || bytes == NULL || cb == NULL) return;
+    pc_maint_poll(ctx, now_ms, enabled, cb);
+    for (i = 0U; i < len; i++)
+    {
+        uint8_t ch = bytes[i];
+        int retry = 1;
+        /* The idle frame callback groups bytes: same callback shares timestamp. */
+        while (retry)
+        {
+            retry = 0;
+            if (ctx->skip_next_lf)
+            {
+                ctx->skip_next_lf = 0U;
+                if (ch == '\n') break;
+            }
+            if (!enabled)
+            {
+                plain[plain_len++] = ch;
+            }
+            else if (ctx->state == PC_MAINT_RAW)
+            {
+                if (ch == '+' &&
+                    ((!ctx->ever_received && now_ms >= PC_MAINT_PRE_GUARD_MS) ||
+                     (ctx->ever_received &&
+                      (uint32_t)(now_ms - ctx->last_byte_ms) >= PC_MAINT_PRE_GUARD_MS)))
+                {
+                    emit_raw(cb, plain, plain_len);
+                    plain_len = 0U;
+                    ctx->candidate[0] = ch;
+                    ctx->length = 1U;
+                    ctx->state = PC_MAINT_PLUS1;
+                    ctx->stage_ms = now_ms;
+                }
+                else plain[plain_len++] = ch;
+            }
+            else if (ctx->state == PC_MAINT_PLUS1 || ctx->state == PC_MAINT_PLUS2)
+            {
+                if (ch == '+' &&
+                    (uint32_t)(now_ms - ctx->stage_ms) <= PC_MAINT_PLUS_GAP_MS)
+                {
+                    ctx->candidate[ctx->length++] = ch;
+                    ctx->stage_ms = now_ms;
+                    ctx->state = (ctx->state == PC_MAINT_PLUS1) ? PC_MAINT_PLUS2 : PC_MAINT_POST;
+                }
+                else
+                {
+                    emit_raw(cb, plain, plain_len);
+                    plain_len = 0U;
+                    replay(ctx, cb);
+                    retry = 1; /* reprocess current byte without loss */
+                }
+            }
+            else if (ctx->state == PC_MAINT_POST)
+            {
+                emit_raw(cb, plain, plain_len);
+                plain_len = 0U;
+                replay(ctx, cb); /* any byte before post-guard is ordinary RAW */
+                retry = 1;
+            }
+            else if (ctx->state == PC_MAINT_DRAIN)
+            {
+                ctx->session_activity_ms = now_ms;
+                if (ch == '\r')
+                {
+                    ctx->state = PC_MAINT_SESSION;
+                    ctx->length = 0U;
+                    ctx->skip_next_lf = 1U;
+                }
+            }
+            else if (ctx->state == PC_MAINT_CONFIRM || ctx->state == PC_MAINT_SESSION)
+            {
+                if (ctx->length == ((ctx->state == PC_MAINT_CONFIRM) ?
+                                    PC_MAINT_CANDIDATE_MAX : PC_MAINT_COMMAND_MAX))
+                {
+                    if (ctx->state == PC_MAINT_CONFIRM)
+                        replay(ctx, cb);
+                    else
+                    {
+                        ctx->length = 0U; /* discard overlong local AT, never execute */
+                        ctx->state = PC_MAINT_DRAIN;
+                    }
+                    retry = (ctx->state == PC_MAINT_RAW);
+                }
+                else
+                {
+                    ctx->candidate[ctx->length++] = ch;
+                    if (ctx->state == PC_MAINT_SESSION)
+                        ctx->session_activity_ms = now_ms;
+                    if (ch == '\r')
+                    {
+                        size_t offset = (ctx->state == PC_MAINT_CONFIRM) ? 3U : 0U;
+                        size_t cmd_len = ctx->length - offset - 1U;
+                        if (ctx->state == PC_MAINT_CONFIRM &&
+                            cmd_len == sizeof("AT+MCUCFG=1") - 1U &&
+                            memcmp(ctx->candidate + offset, "AT+MCUCFG=1", cmd_len) == 0)
+                        {
+                            ctx->state = PC_MAINT_SESSION;
+                            ctx->session_activity_ms = now_ms;
+                            if (cb->command != NULL)
+                                cb->command(cb->user, ctx->candidate + offset, cmd_len);
+                            ctx->length = 0U;
+                            ctx->skip_next_lf = 1U;
+                        }
+                        else if (ctx->state == PC_MAINT_CONFIRM)
+                        {
+                            emit_raw(cb, plain, plain_len);
+                            plain_len = 0U;
+                            replay(ctx, cb);
+                        }
+                        else
+                        {
+                            int exit = (cmd_len == sizeof("AT+MCUCFG=0") - 1U &&
+                                        memcmp(ctx->candidate, "AT+MCUCFG=0", cmd_len) == 0);
+                            if (cb->command != NULL)
+                                cb->command(cb->user, ctx->candidate, cmd_len);
+                            ctx->length = 0U;
+                            ctx->skip_next_lf = 1U;
+                            if (exit) ctx->state = PC_MAINT_RAW;
+                        }
+                    }
+                }
+            }
+        }
+        ctx->last_byte_ms = now_ms;
+        ctx->ever_received = 1U;
+        if (plain_len == sizeof(plain))
+        {
+            emit_raw(cb, plain, plain_len);
+            plain_len = 0U;
+        }
+    }
+    emit_raw(cb, plain, plain_len);
+}
diff --git a/ev_hc32f460_lqfp100_v2/applications/pc_maint_core.h b/applications/pc_maint_core.h
new file mode 100644
index 0000000..601739e
--- /dev/null
+++ b/applications/pc_maint_core.h
@@ -0,0 +1,56 @@
+/* SPDX-License-Identifier: Apache-2.0 */
+#ifndef PC_MAINT_CORE_H
+#define PC_MAINT_CORE_H
+
+#include <stddef.h>
+#include <stdint.h>
+
+/* Hardware-independent V3 guarded escape parser. Times are monotonic milliseconds. */
+#define PC_MAINT_CANDIDATE_MAX 256U
+#define PC_MAINT_COMMAND_MAX 384U
+#define PC_MAINT_PRE_GUARD_MS 1000U
+#define PC_MAINT_POST_GUARD_MS 1000U
+#define PC_MAINT_PLUS_GAP_MS 100U
+#define PC_MAINT_CONFIRM_MS 3000U
+#define PC_MAINT_IDLE_MS 60000U
+
+typedef enum {
+    PC_MAINT_RAW = 0,
+    PC_MAINT_PLUS1,
+    PC_MAINT_PLUS2,
+    PC_MAINT_POST,
+    PC_MAINT_CONFIRM,
+    PC_MAINT_SESSION,
+    PC_MAINT_DRAIN
+} pc_maint_state_t;
+
+typedef void (*pc_maint_raw_cb)(void *user, const uint8_t *bytes, size_t len);
+typedef void (*pc_maint_cmd_cb)(void *user, const uint8_t *line, size_t len);
+
+typedef struct {
+    pc_maint_raw_cb raw;
+    pc_maint_cmd_cb command;
+    void *user;
+} pc_maint_callbacks_t;
+
+typedef struct {
+    pc_maint_state_t state;
+    uint32_t last_byte_ms;
+    uint32_t stage_ms;
+    uint32_t session_activity_ms;
+    uint8_t candidate[PC_MAINT_COMMAND_MAX];
+    size_t length;
+    uint8_t ever_received;
+    uint8_t skip_next_lf;
+} pc_maint_ctx_t;
+
+void pc_maint_init(pc_maint_ctx_t *ctx);
+void pc_maint_poll(pc_maint_ctx_t *ctx, uint32_t now_ms, int enabled,
+                   const pc_maint_callbacks_t *cb);
+void pc_maint_input(pc_maint_ctx_t *ctx, const uint8_t *bytes, size_t len,
+                    uint32_t now_ms, int enabled, const pc_maint_callbacks_t *cb);
+void pc_maint_reset(pc_maint_ctx_t *ctx, const pc_maint_callbacks_t *cb,
+                    int replay_candidate);
+int pc_maint_active(const pc_maint_ctx_t *ctx);
+
+#endif
diff --git a/ev_hc32f460_lqfp100_v2/tests/test_pc_maint.c b/tests/test_pc_maint.c
new file mode 100644
index 0000000..c01a63e
--- /dev/null
+++ b/tests/test_pc_maint.c
@@ -0,0 +1,53 @@
+#include "pc_maint_core.h"
+#include <assert.h>
+#include <stdio.h>
+#include <string.h>
+static unsigned char raw[2048];static size_t rn;static char cmd[30][300];static int cn;
+static void onraw(void *u,const uint8_t *p,size_t n){(void)u; assert(rn+n<=sizeof(raw));memcpy(raw+rn,p,n);rn+=n;}
+static void oncmd(void *u,const uint8_t *p,size_t n){(void)u;assert(cn<30);assert(n<300);memcpy(cmd[cn],p,n);cmd[cn][n]=0;cn++;}
+static const pc_maint_callbacks_t cb={onraw,oncmd,0};
+static void feed(pc_maint_ctx_t *s,const char *p,uint32_t t,int en){pc_maint_input(s,(const uint8_t*)p,strlen(p),t,en,&cb);}
+static void reset(pc_maint_ctx_t *s){pc_maint_init(s);rn=0;cn=0;memset(raw,0,sizeof(raw));memset(cmd,0,sizeof(cmd));}
+int main(void){pc_maint_ctx_t s;reset(&s);
+ /* Guard 1000ms, triple+ <=100ms, post guard, config entered then ordinary AT. */
+ feed(&s,"+",1200,1);feed(&s,"+",1240,1);feed(&s,"+",1290,1);
+ pc_maint_poll(&s,2300,1,&cb);feed(&s,"AT+MCUCFG=1\r\n",2450,1);
+ assert(pc_maint_active(&s)&&cn==1&&!strcmp(cmd[0],"AT+MCUCFG=1")&&rn==0);
+ feed(&s,"AT+MCUVER?\r\n",2480,1);assert(cn==2&&!strcmp(cmd[1],"AT+MCUVER?"));
+ feed(&s,"AT+MCUCFG=0\r\n",2520,1);assert(cn==3&&!pc_maint_active(&s)&&rn==0);
+ feed(&s,"DATA",2530,1);assert(rn==4&&!memcmp(raw,"DATA",4));
+ /* Bad escape suffix must replay exactly once and preserve following bytes. */
+ reset(&s);feed(&s,"RAW",200,1);feed(&s,"+++x",1500,1);
+ assert(rn==7&&!memcmp(raw,"RAW+++x",7));
+ /* Candidate fragmented then incomplete: exact original bytes go to RAW. */
+ reset(&s);feed(&s,"++",1500,1);pc_maint_poll(&s,1700,1,&cb);
+ assert(rn==2&&!memcmp(raw,"++",2));
+ /* Invalid confirm command -> RAW exactly, including CR and LF. */
+ reset(&s);feed(&s,"+++",2000,1);pc_maint_poll(&s,3100,1,&cb);
+ feed(&s,"AT+BAD\r\n",3250,1);assert(cn==0);
+ assert(rn==11&&!memcmp(raw,"+++AT+BAD\r\n",11));
+ /* 3s timeout after 1s post quiet. */
+ reset(&s);feed(&s,"+++",2000,1);pc_maint_poll(&s,6500,1,&cb);
+ assert(rn==3&&!memcmp(raw,"+++",3));
+ /* Disabling entry must never intercept RAW data. */
+ reset(&s);feed(&s,"+++AT+MCUCFG=1\r",2000,0);
+ assert(!pc_maint_active(&s)&&rn==strlen("+++AT+MCUCFG=1\r"));
+ /* 60 second idle expiration discards incomplete control, then resumes RAW. */
+ reset(&s);feed(&s,"+++",2000,1);pc_maint_poll(&s,3000,1,&cb);
+ feed(&s,"AT+MCUCFG=1\r",3200,1);feed(&s,"AT+MCU",3210,1);
+ pc_maint_poll(&s,64000,1,&cb);assert(!pc_maint_active(&s));
+ feed(&s,"test",64030,1);assert(rn==4&&!memcmp(raw,"test",4));
+ /* Embedded binary byte remains unmodified in RAW mode. */
+ reset(&s);{uint8_t p[]={0,0xff,0x0d,0x0a,'+','+'};pc_maint_input(&s,p,sizeof(p),1500,1,&cb);
+ assert(rn==sizeof(p)&&!memcmp(raw,p,sizeof(p)));}
+ /* Must not recognize +++ during first second of boot. */
+ reset(&s);feed(&s,"+++",100,1);assert(rn==3&&!memcmp(raw,"+++",3));
+ /* Hostname-size local AT line is valid after entry (candidate remains capped). */
+ reset(&s);feed(&s,"+++",2000,1);pc_maint_poll(&s,3000,1,&cb);
+ feed(&s,"AT+MCUCFG=1\r",3100,1);
+ {char long_cmd[290];size_t i;memcpy(long_cmd,"AT+MCUHOST=",11);
+ for(i=11;i<270;i++) long_cmd[i]='a';
+ long_cmd[270]='\r';
+ long_cmd[271]=0;
+ feed(&s,long_cmd,3200,1);assert(cn==2&&strlen(cmd[1])==270);}
+ puts("PASS: maintenance guard/confirm/replay/timeout/exit/disabled/binary/long-AT");return 0;}
