+
+static rt_bool_t maint_enabled(void)
+{
+    param_config_t cfg;
+    param_get_snapshot(&cfg);
+    return cfg.work_mode == PARAM_MODE_RAW_UPLINK && cfg.pc_cfg_enabled;
